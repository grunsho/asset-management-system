{
  "name": "asset-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest watch tests/unit",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint apps tests playwright.config.ts vitest.config.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx}\" \".github/**/*.{yml,yaml}\" \"*.config.{js,ts}\" \"*.{yml,yaml,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx}\" \".github/**/*.{yml,yaml}\" \"*.config.{js,ts}\" \"*.{yml,yaml,json}\"",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
