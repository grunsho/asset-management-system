POSTGRES_USER=ams_user
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=asset_management
DATABASE_URL=postgresql://ams_user:replace-with-a-long-random-value@postgres:5432/asset_management?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CLIENT_URL=https://your-frontend-domain.example
WEB_PORT=8080
ADMIN_EMAIL=initial-admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters